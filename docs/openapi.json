{
  "openapi": "3.0.1",
  "info": {
    "title": "OficinaMecanica.Execucao API",
    "description": "Fila de execução, diagnóstico e reparo da oficina mecânica. O mecânico é sempre o do token JWT (claim 'sub'), nunca o do corpo da requisição.",
    "version": "v1"
  },
  "paths": {
    "/api/diagnosticos/proximo": {
      "post": {
        "tags": [
          "Diagnosticos"
        ],
        "summary": "Reivindica a próxima ordem da fila de diagnóstico.",
        "description": "A fila é FIFO pela data de entrada. A ordem passa para `EmDiagnostico` e fica sob responsabilidade\ndo mecânico do token (claim `sub`); o evento `DiagnosticoIniciado` é publicado na mesma\ntransação. Dois mecânicos nunca recebem a mesma ordem.",
        "operationId": "Diagnosticos_ReivindicarProximo",
        "responses": {
          "200": {
            "description": "Ordem reivindicada.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/OrdemDeProducaoDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdemDeProducaoDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdemDeProducaoDto"
                }
              }
            }
          },
          "204": {
            "description": "Fila de diagnóstico vazia."
          },
          "401": {
            "description": "Token ausente, inválido ou sem o claim `sub`.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Disputa pela fila não resolvida após as tentativas; repita a chamada.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/fila": {
      "get": {
        "tags": [
          "Fila"
        ],
        "summary": "Lista as ordens de produção com filtros e paginação.",
        "description": "Com filtro de status a ordem reflete a ordem de consumo (data de entrada na fila de diagnóstico,\ndata de liberação na fila de reparo); sem filtro, pela data de entrada.",
        "operationId": "Fila_Listar",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Filtra por status (por exemplo `Fila`, `EmDiagnostico`, `AguardandoExecucao`).",
            "schema": {
              "$ref": "#/components/schemas/StatusProducao"
            }
          },
          {
            "name": "mecanicoId",
            "in": "query",
            "description": "Filtra pelo mecânico responsável (id opaco do token).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "description": "Página, a partir de 1.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "tamanho",
            "in": "query",
            "description": "Itens por página, de 1 a 100.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de ordens.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/OrdemDeProducaoResumoDtoPaginacaoResultDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdemDeProducaoResumoDtoPaginacaoResultDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdemDeProducaoResumoDtoPaginacaoResultDto"
                }
              }
            }
          },
          "400": {
            "description": "Parâmetros inválidos.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
