        "summary": "Reivindica a próxima ordem liberada para reparo.",
        "description": "A fila é FIFO pelo momento em que a ordem foi liberada (pagamento aprovado e diagnóstico concluído),\nnão pela data de entrada. A ordem passa para `EmExecucao` e o mecânico do token (claim\n`sub`) vira o responsável.",
        "operationId": "Reparos_ReivindicarProximo",
        "responses": {
          "200": {
            "description": "Ordem reivindicada.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/OrdemDeProducaoDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdemDeProducaoDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdemDeProducaoDto"
                }
              }
            }
          },
          "204": {
            "description": "Fila de reparo vazia."
          },
          "401": {
            "description": "Token ausente, inválido ou sem o claim `sub`.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Disputa pela fila não resolvida após as tentativas; repita a chamada.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
