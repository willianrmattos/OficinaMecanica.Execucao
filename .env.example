# Copie para .env e preencha. O .env nunca e versionado.

# --- API ---
# Porta publicada da API no host (a do container e sempre 8080).
EXECUCAO_API_PORT=5002
# JWKS do OficinaMecanica.Seguranca rodando local (docker compose do Seguranca publica a 7071).
JWKS_URI=http://host.docker.internal:7071/.well-known/jwks.json

# --- MongoDB (replica set de 1 no, necessario para as transacoes do outbox) ---
# Porta publicada no host, so para ferramentas (mongosh, Compass) com directConnection=true.
EXECUCAO_MONGO_PORT=27018

# --- RabbitMQ ---
# O broker compartilhado vive no docker compose do OS Service (5672/15672). Para rodar a Execucao sozinha:
#   docker compose --profile standalone up -d
# e aponte a API para o broker deste compose:
#   RABBITMQ_HOST=rabbitmq
#   RABBITMQ_PORT=5672
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER=<usuario-do-rabbitmq>
RABBITMQ_PASS=<senha-do-rabbitmq>
# Portas do broker do perfil standalone (diferentes das do broker do OS Service).
EXECUCAO_RABBITMQ_PORT=5673
EXECUCAO_RABBITMQ_MGMT_PORT=15673

# --- Observabilidade (opcional) ---
# Endpoint OTLP gRPC; vazio desliga traces e metricas por OTLP.
OTEL_ENDPOINT=

# Prefixo dos nomes dos containers (padrao: oficinamecanica-execucao).
# EXECUCAO_PREFIXO=oficinamecanica-execucao
