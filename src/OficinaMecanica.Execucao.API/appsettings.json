{
  "ConnectionStrings": {
    "MongoDb": ""
  },
  "MongoDb": {
    "Database": "execucao"
  },
  "JwtSettings": {
    "Issuer": "OficinaMecanica.Seguranca",
    "Audience": "OficinaMecanica.Client",
    "JwksUri": "https://apimfiap.azure-api.net/segurancaserver/.well-known/jwks.json"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "",
    "Password": ""
  },
  "Mensageria": {
    "Transporte": "RabbitMq",
    "Outbox": "MongoDb",
    "Retentativas": 5,
    "IntervaloInicialEmMs": 200,
    "IntervaloMaximoEmMs": 30000,
    "IntervaloDoOutboxEmMs": 1000,
    "JanelaDeDeduplicacaoEmMinutos": 30
  },
  "Metricas": {
    "IntervaloDeAtualizacaoEmSegundos": 15
  },
  "Otel": {
    "Endpoint": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "MassTransit": "Information"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
